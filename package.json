{
  "name": "hello-world",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "lint": "tsc --noEmit",
    "start": "node dist/server.cjs",
    "preview": "vite preview --host 0.0.0.0 --port 3000"
  },
  "dependencies": {
    "express": "^5.2.1",
    "lucide-react": "^1.16.0",
    "motion": "^12.4.7",
    "nodemailer": "^10.0.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.23.15",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  }
}
